SAGE_IMAGE=sage-icpp-demo:20260926-cpu-full
SAGE_PORT=18400
SAGE_BIND_ADDRESS=0.0.0.0
# Override with the Docker bridge address (for example 172.17.0.1) only when
# the daemon does not support Docker's host-gateway alias.
SAGE_HOST_GATEWAY=host-gateway
SAGE_LLM_BASE_URL=http://11.11.11.31:8000/v1
SAGE_LLM_MODEL=Qwen2.5-3B-Instruct
SAGE_RERANKER_BASE_URL=http://11.11.11.31:8001
# No embedding service has been established. Do not use reranker here.
SAGE_EMBEDDING_BASE_URL=
SAGE_OPENAI_API_KEY=EMPTY
PYTHON_IMAGE=python:3.11.6-slim-bookworm

# Bundled official Linux AMD64 base manifest: sha256:38a28170d13a276d42b7dd55cae54440b581d773549d361d19089ec47d4791c5
# Verified base image ID: sha256:7ba9869f7b1ec033dcb18de3edd51eb8d34286f6dc7e5513aaeeab3b603cab18

# Authenticated provider adapter. It forwards credentials for model discovery
# as well as inference, so the UI does not incorrectly report a 401 as unreachable.
SAGE_ENTRYPOINT=/opt/demo-tools/start-providers.sh
SAGE_EMBEDDING_MODEL=
SAGE_EMBEDDING_API_KEY=
SAGE_EMBEDDING_PROVIDER=openai
SAGE_RERANKER_MODEL=
SAGE_RERANKER_API_KEY=
SAGE_RERANKER_PROVIDER=openai
SAGE_MODEL_TIMEOUT=90
